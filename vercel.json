{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "bash scripts/vercel-flywire-build.sh",
  "outputDirectory": "dist",
  "functions": {
    "api/*.py": {
      "includeFiles": "upstream/**",
      "excludeFiles": "{dist/**,node_modules/**,tests/**}",
      "maxDuration": 300
    }
  }
}
